generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  address     String?
  phone       String?
  themeColor  String     @default("#d62828")
  menuItems   MenuItem[]
  categories  MenuCategory[]
  modifierGroups ModifierGroup[]
  orders      Order[]
  restaurantUsers RestaurantUser[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model RestaurantUser {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email        String     @unique
  name         String?
  picture      String?
  role         String     @default("OWNER")
  status       String     @default("APPROVED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuCategory {
  id           Int        @id @default(autoincrement())
  name         String
  sortOrder    Int        @default(0)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
}

model MenuItem {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  imageUrl     String?
  category     String?
  categoryId   Int?
  menuCategory MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price        Decimal    @db.Decimal(10, 2)
  isAvailable  Boolean    @default(true)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  modifierGroupLinks MenuItemModifierGroup[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ModifierGroup {
  id             Int        @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  required       Boolean    @default(false)
  allowMultiple  Boolean    @default(false)
  minSelections  Int        @default(0)
  maxSelections  Int?
  sort           Int        @default(0)
  options        ModifierOption[]
  menuItemLinks  MenuItemModifierGroup[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([restaurantId, name])
}

model ModifierOption {
  id              Int           @id @default(autoincrement())
  modifierGroupId Int
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  priceDelta      Decimal       @default(0) @db.Decimal(10, 2)
  sort            Int           @default(0)
  available       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MenuItemModifierGroup {
  id              Int           @id @default(autoincrement())
  menuItemId      Int
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId Int
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?
  status        String      @default("PENDING")
  total         Decimal     @db.Decimal(10, 2)
  acceptedAt    DateTime?
  printedAt     DateTime?
  cancelledAt   DateTime?
  restaurantId  Int
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  name       String
  price      Decimal  @db.Decimal(10, 2)
  basePrice  Decimal  @default(0) @db.Decimal(10, 2)
  finalPrice Decimal  @default(0) @db.Decimal(10, 2)
  quantity   Int
  customerComment String?
  selectedModifiers Json @default("[]")
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
