# Copy this file to .env and update the values for your environment.

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# For local development against DynamoDB Local (see docker-compose.yml):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
DYNAMODB_ENDPOINT=http://localhost:8000
# Optional prefix so multiple environments can share one AWS account (e.g. "dev_").
# DYNAMODB_TABLE_PREFIX=
#
# For real AWS, leave DYNAMODB_ENDPOINT unset and provide real region +
# credentials (or rely on an instance role / shared credentials file).

PORT=3000
FRONTEND_URL=
# Optional comma-separated list if you need more than one hosted frontend origin.
# CORS_ORIGINS=https://example.netlify.app,https://www.example.com
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
JWT_SECRET=
# Restaurant tablet app bearer tokens. Format: restaurantId:token,restaurantId:token
TABLET_AGENT_TOKENS=1:dev-tablet-token
# Optional single token that can access every restaurant. Use only for local development.
TABLET_AGENT_TOKEN=
# Local development only. Leave false in shared/staging/production environments.
ADMIN_AUTH_BYPASS=false
# Which restaurant receives phone orders. Defaults to 1 if not set.
VOICE_RESTAURANT_ID=1
# Twilio phone number assigned to the restaurant (E.164 format). Used by seed.
TWILIO_PHONE_NUMBER=+19313399781
